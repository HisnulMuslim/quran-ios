"help_page_title" = "ಪದೇ ಪದೇ ಕೇಳಲಾಗುವ ಪ್ರಶ್ನೆಗಳು";
"help_q1_question" = "ನಾನು ಪಠ್ಯವನ್ನು ಹೇಗೆ ದೊಡ್ಡದಾಗಿ ಮಾಡಬಹುದು?";
"help_q1_answer" = "ಅರೇಬಿಕ್ ಪುಟಗಳಿಗಾಗಿ, ನಿಮ್ಮ ಫೋನ್ ಅನ್ನು ಲ್ಯಾಂಡ್‌ಸ್ಕೇಪ್‌ನಲ್ಲಿ ಹಿಡಿದುಕೊಳ್ಳಿ. ಇದು ಪಠ್ಯವನ್ನು ದೊಡ್ಡದಾಗಿ ಮಾಡುತ್ತದೆ. ಅನುವಾದಗಳಿಗಾಗಿ, ಬಲ ಮೂಲೆಯಲ್ಲಿರುವ ೩ ಚುಕ್ಕೆಗಳನ್ನು (3 dots) ಕ್ಲಿಕ್ ಮಾಡಿ, ಥೀಮ್‌ಗಳು/ಸೆಟ್ಟಿಂಗ್‌ಗಳಿಗೆ (themes/settings) ಹೋಗಿ ಮತ್ತು ಅನುವಾದ ಪಠ್ಯದ ಗಾತ್ರವನ್ನು ಹೊಂದಿಸಿ.";
"help_q2_question" = "ನಾನು ಆಡಿಯೊವನ್ನು ಹೇಗೆ ಪ್ಲೇ ಮಾಡಬಹುದು?";
"help_q2_answer" = "ಯಾವುದೇ ಕುರ್ ಆನ್ ಪುಟವನ್ನು ತೆರೆಯಿರಿ. ಪರದೆಯ ಮೇಲೆ ಒಮ್ಮೆ ಟ್ಯಾಪ್ ಮಾಡಿ. ಕೆಳಭಾಗದಲ್ಲಿ, ನೀವು ಪ್ಲೇ ಬಟನ್ ಮತ್ತು ಖಾರಿಯ ಹೆಸರಿನ ಕೆಲವು ಪಠ್ಯವನ್ನು ಗಮನಿಸಬಹುದು. ಬೇರೆ ಖಾರಿಯನ್ನು ಆಯ್ಕೆ ಮಾಡಲು ಖಾರಿಯ ಹೆಸರನ್ನು ಕ್ಲಿಕ್ ಮಾಡಿ. ಪ್ರಸ್ತುತ ಪುಟ ಅಥವಾ ಸೂರಾವನ್ನು ಡೌನ್‌ಲೋಡ್ ಮಾಡಲು ಮತ್ತು ಪ್ಲೇ ಮಾಡಲು ಪ್ಲೇ ಕ್ಲಿಕ್ ಮಾಡಿ.";
"help_q3_question" = "ನಾನು ಅನುವಾದವನ್ನು ಹೇಗೆ ವೀಕ್ಷಿಸಬಲ್ಲೆ?";
"help_q3_answer" = "ಯಾವುದೇ ಕುರ್ ಆನ್ ಪುಟವನ್ನು ತೆರೆಯಿರಿ. ಪರದೆಯ ಮೇಲೆ ಒಮ್ಮೆ ಟ್ಯಾಪ್ ಮಾಡಿ. ಮೇಲ್ಭಾಗದಲ್ಲಿ, ಮೂರು ಚುಕ್ಕೆಗಳನ್ನು ಹೊಂದಿರುವ ಐಕಾನ್ ಅನ್ನು ಗಮನಿಸಿ - ಅನುವಾದವನ್ನು ವೀಕ್ಷಿಸಲು ಇದನ್ನು ಕ್ಲಿಕ್ ಮಾಡಿ ಮತ್ತು ಅನುವಾದವನ್ನು ಆಯ್ಕೆಮಾಡಿ. ಅನುವಾದವನ್ನು ಆರಿಸಿ ಮತ್ತು ಡೌನ್‌ಲೋಡ್ ಮಾಡಿ.";
"help_q4_question" = "ನಾನು ಪುಟವನ್ನು ಹೇಗೆ ಬುಕ್‌ಮಾರ್ಕ್ ಮಾಡುವುದು?";
"help_q4_answer" = "ಯಾವುದೇ ಕುರ್ ಆನ್ ಪುಟವನ್ನು ತೆರೆಯಿರಿ. ಪರದೆಯ ಮೇಲೆ ಒಮ್ಮೆ ಟ್ಯಾಪ್ ಮಾಡಿ. ಮೇಲಿನ ಬಲಭಾಗದಲ್ಲಿ, ನೀವು ಬುಕ್‌ಮಾರ್ಕ್ ಐಕಾನ್ ಅನ್ನು ನೋಡುತ್ತೀರಿ. ಪುಟವನ್ನು ಬುಕ್‌ಮಾರ್ಕ್ ಮಾಡಲು ಐಕಾನ್ ಅನ್ನು ಟ್ಯಾಪ್ ಮಾಡಿ (ಬಣ್ಣವು ಘನ ಬಿಳಿ ಬಣ್ಣಕ್ಕೆ ತಿರುಗುತ್ತದೆ). ಬುಕ್‌ಮಾರ್ಕ್ ತೆಗೆದುಹಾಕಲು ಬುಕ್‌ಮಾರ್ಕ್ ಐಕಾನ್ ಅನ್ನು ಮತ್ತೊಮ್ಮೆ ಟ್ಯಾಪ್ ಮಾಡಿ.";
"help_q5_question" = "ನಾನು ಆಯತ್ ಅನ್ನು ಹೇಗೆ ಹಂಚಿಕೊಳ್ಳಬಹುದು?";
"help_q5_answer" = "ಯಾವುದೇ ಅರೇಬಿಕ್ ಪುಟದಲ್ಲಿರುವಾಗ, ಆಯತ್ ಅನ್ನು ಬುಕ್‌ಮಾರ್ಕ್ ಮಾಡಲು, ಟ್ಯಾಗ್ ಮಾಡಲು, ಹಂಚಿಕೊಳ್ಳಲು ಅಥವಾ ಕ್ಲಿಪ್‌ಬೋರ್ಡ್‌ಗೆ ನಕಲಿಸಲು, ಅನುವಾದವನ್ನು ನೋಡಲು ಅಥವಾ ಅದರ ಪಠಣವನ್ನು ಕೇಳಲು ನೀವು ಆಯ್ಕೆಮಾಡಬಲ್ಲ ಮೆನುವನ್ನು ಪಡೆಯಲು ಯಾವುದೇ ಆಯತ್ ಅನ್ನು ಒತ್ತಿ ಹಿಡಿದುಕೊಳ್ಳಿ.";
"help_footer_contact_text" = "ನಿಮ್ಮ ಪ್ರಶ್ನೆಗೆ ಮೇಲೆ ಉತ್ತರಿಸದಿದ್ದರೆ, ಬೆಂಬಲಕ್ಕಾಗಿ ನೀವು hmkannada@gmail.com ಗೆ ಇಮೇಲ್ ಮಾಡಬಹುದು. ದಯವಿಟ್ಟು ಗಮನಿಸಿ, ನಾವು ಸಾಕಷ್ಟು ಇಮೇಲ್‌ಗಳನ್ನು ಸ್ವೀಕರಿಸುತ್ತೇವೆ, ಆದ್ದರಿಂದ ನಾವು ಎಲ್ಲದಕ್ಕೂ ಪ್ರತ್ಯುತ್ತರಿಸಲು ಸಾಧ್ಯವಾಗದಿರಬಹುದು.";


